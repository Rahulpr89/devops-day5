{
  "family": "my-app-tast",
  "executionRoleArn": "arn:aws:iam::832721971180:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::832721971180:role/my-ecs-role",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "3072",
  "containerDefinitions": [
    {
      "name": "my-container",
      "image": "832721971180.dkr.ecr.us-east-1.amazonaws.com/my-web-ecr:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/my-app-tast",
          "awslogs-create-group": "true",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
